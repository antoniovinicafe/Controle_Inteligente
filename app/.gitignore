# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------------------
# Acrescentado ao padrão do Flutter
# ---------------------------------------------------------------------------

# APKs gerados. O fetin-celular.apk da raiz tem ~56 MB e é refeito a cada
# build - se entrar uma vez, fica no histórico do git pra sempre, mesmo
# depois de apagado. Quem precisa do APK pega da última build, não do repo.
*.apk
*.aab

# Cache do Gradle e artefatos de plataforma que o Flutter regenera sozinho.
/android/.gradle/
/windows/flutter/ephemeral/
/linux/flutter/ephemeral/
/macos/Flutter/ephemeral/

# Segredos, se um dia forem extraídos do app_config.dart pra um arquivo.
# (Hoje as chaves ainda estão no código - ver README.)
.env
*.env
!.env.example
*.keystore
*.jks
key.properties

# ATENÇÃO - o que NÃO deve ser ignorado:
#   assets/fonts/*.ttf     as fontes agora fazem parte do app
#   assets/licencas/*.txt  exigidas pela licença OFL das fontes
#   pubspec.lock           versões exatas, essencial pra build reproduzível
