# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase
# (Project Settings > API e Project Settings > Database)

# Connection string do Postgres (Project Settings > Database > Connection string > URI)
# Use a versão "Session pooler" ou "Transaction pooler" se for rodar em produção/serverless
DATABASE_URL=postgresql://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Project Settings > API > Project URL
# Usado pelo Flask pra buscar a JWKS (chave pública) do projeto e
# VALIDAR o token que o Supabase Auth emite (o Flask não gera token aqui)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Legado: só necessário se o projeto ainda assina com HS256 (segredo
# compartilhado) em vez de ES256/JWKS. Projetos novos podem deixar em branco.
SUPABASE_JWT_SECRET=

# Porta local do Flask
PORT=5000

# Quanta certeza o anti-spoofing precisa ter pra NEGAR alguém (0 a 1).
# Padrão 0.60, medido na porta com a câmera em 720p: pessoa de verdade foi
# confundida com foto no máximo a 58%, e fotos marcaram 68%, 99% e 100%.
# Baixar aperta (barra mais gente de verdade junto), subir afrouxa, acima de
# 1.0 desliga. O modelo é sensível ao ambiente e à resolução da câmera - em
# sala nova, olhe as linhas "[vivacidade] ..." no console do servidor e
# recalibre com aqueles números em vez de confiar neste.
ANTISPOOF_LIMIAR=0.60
