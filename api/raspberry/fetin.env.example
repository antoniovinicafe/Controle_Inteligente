# Copie para ~/.config/fetin.env na Raspberry.
#
# FETIN_API é opcional e serve só pra pular a varredura no primeiro boot.
# Se estiver errado ou vazio, descobrir_api.py acha o servidor sozinho e
# salva em ~/.fetin/api — não precisa editar nada quando o IP mudar.
FETIN_API=http://192.168.0.10:5000/api

# Nome da sala mostrado na tela e usado pra achar a aula em andamento.
# Precisa bater com o `local` dos eventos.
FETIN_SALA=QUADRA

# ------------------------------------------------------------
# Ajuste físico da porta
#
# Estes três dependem de como a câmera e a tela foram parafusadas na
# caixa, então não existe valor certo universal - o certo é o que fica
# bom NAQUELA porta. Os valores comentados abaixo são os que funcionaram
# na caixa impressa em 21/09/2026, e estão aqui pra que o conhecimento
# não viva só dentro do cartão SD.
# ------------------------------------------------------------

# Quantos graus girar a imagem da câmera, no sentido anti-horário, pra
# ela ficar em pé. 0, 90, 180 ou 270.
#
# O cabo flat não cabia na caixa com a câmera na posição natural, e ela
# ficou parafusada girada. Sem corrigir, o rosto chega deitado no
# detector e quase nunca é detectado - a porta responde "nenhum rosto
# detectado" sem dar pista de que a causa é mecânica.
#
# Pra achar o valor: olhe o preview e veja quanto falta girar pra pessoa
# ficar em pé. Na porta ficou 90.
FETIN_ROTACAO=0

# Encolhe o desenho, de 0 a 1, e centraliza. Cria folga entre o conteúdo
# e a borda da tela.
#
# Serve pra dois problemas diferentes: monitor barato que anuncia uma
# resolução por HDMI e mostra menos, e moldura que cobre a beirada do
# LCD. Na porta ficou 0.86, por causa da moldura impressa.
FETIN_MARGEM=1.0

# Desloca o desenho na vertical, em fração da altura da tela. Negativo
# sobe, positivo desce.
#
# A margem sozinha não resolve quando o que tapa é assimétrico: a moldura
# da caixa cobre só a parte de baixo, e liberar 15% embaixo com margem
# uniforme desperdiçaria os mesmos 15% em cima. A margem dá a folga, este
# empurra a folga pro lado que precisa. Na porta ficou -0.06.
FETIN_DESLOCA_Y=0
